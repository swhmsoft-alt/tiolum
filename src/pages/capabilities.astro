---
/**
 * /capabilities/ — the most important screening page on the site.
 *
 * Every capability number is imported from src/lib/capabilities.ts.
 * The "What We Do Not Machine" block is the trust and filtering device and
 * must render in full.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { CAPABILITIES } from '../lib/capabilities';
import { breadcrumbSchema, serviceSchema } from '../lib/schema';

const title = 'Machining Capabilities and Scope';
const description =
  'What we machine in titanium, what we do not, maximum part size, materials, tolerance, finishing and inspection documents — confirmed before quotation.';

const jsonLd = [
  serviceSchema(),
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Capabilities', path: '/capabilities/' }]),
];
---

<BaseLayout title={title} description={description} path="/capabilities/" jsonLd={jsonLd}>
  <!-- Page header -->
  <section class="border-b border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <p class="eyebrow">Capabilities</p>
      <h1 class="mt-3 max-w-3xl text-3xl md:text-4xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-600">
        What we machine, what we do not, and how we confirm fit before quoting.
      </p>
    </div>
  </section>

  <!-- Capability overview -->
  <section class="container-page py-14">
    <h2 class="text-2xl">Capability Overview</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
      A focused scope, not every titanium part. If your drawing fits the table below, we can review it.
    </p>

    <div class="mt-8 overflow-x-auto">
      <table class="data-table">
        <caption class="sr-only">Machining capability overview</caption>
        <thead>
          <tr>
            <th scope="col">Item</th>
            <th scope="col">Specification</th>
            <th scope="col">Boundary</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Process</th>
            <td>{CAPABILITIES.processes.join(', ')}</td>
            <td class="text-ink-500">5-axis is not in scope.</td>
          </tr>
          <tr>
            <th scope="row">Tolerance</th>
            <td>{CAPABILITIES.tolerance}</td>
            <td class="text-ink-500">Evaluated by feature and drawing; not a blanket guarantee.</td>
          </tr>
          <tr>
            <th scope="row">Materials</th>
            <td>{CAPABILITIES.materials.join(', ')}</td>
            <td class="text-ink-500">Grades outside this list may be reviewed case by case.</td>
          </tr>
          <tr>
            <th scope="row">Max part size</th>
            <td>
              Milling: {CAPABILITIES.maxPartSize.milling}<br />
              Turning: {CAPABILITIES.maxPartSize.turning}
            </td>
            <td class="text-ink-500">{CAPABILITIES.maxPartSize.note}</td>
          </tr>
          <tr>
            <th scope="row">Batch range</th>
            <td>{CAPABILITIES.batchRange}</td>
            <td class="text-ink-500">Repeat orders are quoted from the archived drawing record.</td>
          </tr>
          <tr>
            <th scope="row">Finishing</th>
            <td>{CAPABILITIES.finishing.join(', ')}</td>
            <td class="text-ink-500">Only processes our qualified suppliers actually support are listed.</td>
          </tr>
          <tr>
            <th scope="row">Inspection</th>
            <td>{CAPABILITIES.inspection.join(', ')}</td>
            <td class="text-ink-500">Inspection plan is agreed before quotation, not after production.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="mt-12 text-lg">Material Standards</h3>
    <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
      Grade names are quoted against the standard you specify on the drawing.
    </p>
    <ul class="mt-5 flex flex-col gap-2 text-sm text-ink-700">
      {CAPABILITIES.materialStandards.map((std) => <li>{std}</li>)}
    </ul>
  </section>

  <!-- Part families -->
  <section class="border-t border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <h2 class="text-2xl">Part Families</h2>
      <dl class="mt-6 grid gap-5 md:grid-cols-2">
        {
          CAPABILITIES.partFamilies.map((family) => (
            <div class="card p-5">
              <dt class="font-semibold text-ink-950">{family.name}</dt>
              <dd class="mt-1.5 text-sm leading-relaxed text-ink-600">{family.description}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- What we do not machine — the screening and trust block -->
  <section class="container-page py-14">
    <h2 class="text-2xl">What We Do Not Machine</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
      Being explicit about scope saves both sides time. If your part falls into any category below, we will
      decline and explain why.
    </p>
    <ul class="mt-6 flex flex-col gap-3">
      {
        CAPABILITIES.notOffered.map((item) => (
          <li class="flex flex-col gap-1 border-l-2 border-warn-500 bg-warn-50 px-4 py-3">
            <span class="font-semibold text-ink-950">{item.item}</span>
            <span class="text-sm text-ink-600">— {item.reason}.</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-sm leading-relaxed text-ink-600">
      If your part is not listed here but you are unsure, send the drawing — we will tell you honestly.
    </p>
  </section>

  <!-- Supply chain -->
  <section class="border-t border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <h2 class="text-2xl">How We Organize Supply</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
        Every quotation is built from at least two qualified suppliers in Baoji, China. Comparing two
        independent quotes controls price and creates quality redundancy. Supplier identities are never
        disclosed; the customer relationship, drawing record and inspection documents stay with us.
      </p>
    </div>
  </section>

  <!-- Lead time split: our response vs supplier manufacturing -->
  <section class="container-page py-14">
    <h2 class="text-2xl">Lead Time</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
      Two different clocks, kept separate. Our response time is how long we take to answer you. Manufacturing
      time is how long the parts take once the order is confirmed.
    </p>

    <h3 class="mt-8 text-lg">Our response</h3>
    <div class="mt-4 overflow-x-auto">
      <table class="data-table">
        <caption class="sr-only">Titolum response times</caption>
        <thead>
          <tr>
            <th scope="col">Step</th>
            <th scope="col">Time</th>
          </tr>
        </thead>
        <tbody>
          {
            CAPABILITIES.responseTimes.map((row) => (
              <tr>
                <th scope="row">{row.step}</th>
                <td>{row.time}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h3 class="mt-10 text-lg">Manufacturing time at the supplier</h3>
    <div class="mt-4 overflow-x-auto">
      <table class="data-table">
        <caption class="sr-only">Supplier manufacturing lead times by batch size</caption>
        <thead>
          <tr>
            <th scope="col">Batch size</th>
            <th scope="col">Typical duration</th>
            <th scope="col">Driver</th>
          </tr>
        </thead>
        <tbody>
          {
            CAPABILITIES.leadTimes.map((row) => (
              <tr>
                <th scope="row">{row.batch}</th>
                <td>{row.days}</td>
                <td class="text-ink-600">{row.note}</td>
              </tr>
            ))
          }
          <tr>
            <th scope="row">Surface finishing</th>
            <td colspan="2" class="text-ink-600">Adds {CAPABILITIES.finishingAddOn}.</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-ink-500">
      Lead time is confirmed per order. We quote a specific date with every quotation and commit to it.
    </p>
  </section>

  <!-- Closing CTA -->
  <section class="border-t border-ink-200 bg-ink-950">
    <div class="container-page py-14">
      <h2 class="text-2xl text-white">Your Part Is Not Listed?</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-ink-300">
        Send the drawing anyway. We will confirm within one business day whether it fits our scope.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/rfq/"
          class="rounded-md bg-white px-5 py-2.5 text-sm font-semibold text-ink-950 transition-colors hover:bg-ink-100"
        >
          Upload Drawing
        </a>
        <a
          href="/how-it-works/"
          class="rounded-md border border-ink-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-ink-800"
        >
          View How It Works
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
