---
/**
 * /case-studies/[slug]/ — 案例详情页。
 *
 * 结构：面包屑 → 标题 + Illustrative 标签 → 元信息表 → 正文五段 → 相关案例 → CTA。
 * 规则：不出现客户名、工厂名、价格；公差等数字从 CAPABILITIES 引用。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CAPABILITIES } from '../../lib/capabilities';
import { CASE_STUDIES, getPartFamilyName } from '../../lib/caseStudies';
import { breadcrumbSchema } from '../../lib/schema';

export function getStaticPaths() {
  return CASE_STUDIES.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props;

const path = `/case-studies/${study.slug}/`;
const title = study.title;
const description = study.summary;

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Case Studies', path: '/case-studies/' },
    { name: study.title, path },
  ]),
];

const others = CASE_STUDIES.filter((item) => item.slug !== study.slug);

const metaRows = [
  { label: 'Industry', value: study.industry },
  { label: 'Part family', value: getPartFamilyName(study.partFamily), href: `/parts/${study.partFamily}/` },
  { label: 'Material', value: study.material },
  { label: 'Tolerance', value: CAPABILITIES.tolerance },
  { label: 'Batch', value: study.batch },
  { label: 'Finishing', value: study.finishing },
  { label: 'Inspection', value: study.inspection },
  { label: 'Lead time', value: study.leadTime },
  { label: 'Repeat scenario', value: study.repeatScenario },
] as const;
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <!-- Header -->
  <section class="border-b border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <nav aria-label="Breadcrumb" class="text-sm text-ink-500">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-ti-700">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/case-studies/" class="hover:text-ti-700">Case Studies</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink-700" aria-current="page">{study.industry}</li>
        </ol>
      </nav>

      <div class="mt-5 flex flex-wrap items-center gap-2">
        <span class="inline-block rounded bg-ti-50 px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-ti-700">
          {study.industry}
        </span>
        <span class="inline-block rounded bg-warn-100 px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-warn-600">
          Illustrative example
        </span>
      </div>

      <h1 class="mt-4 max-w-3xl text-3xl md:text-4xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-600">{study.summary}</p>
    </div>
  </section>

  <!-- Meta table -->
  <section class="container-page py-14">
    <h2 class="text-2xl">Case Summary</h2>
    <div class="mt-8 overflow-x-auto">
      <table class="data-table">
        <caption class="sr-only">Case summary for {title}</caption>
        <thead>
          <tr>
            <th scope="col">Item</th>
            <th scope="col">Specification</th>
          </tr>
        </thead>
        <tbody>
          {
            metaRows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td class="text-ink-600">
                  {'href' in row && row.href ? (
                    <a href={row.href} class="text-ti-700 underline underline-offset-2">
                      {row.value}
                    </a>
                  ) : (
                    row.value
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm leading-relaxed text-ink-500">
      This is an illustrative example describing a typical scenario. It is not a confirmed client transaction, and no
      client or supplier identity is disclosed.
    </p>
  </section>

  <!-- Body -->
  <section class="border-t border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <div class="prose-ti max-w-3xl">
        <h2 class="!mt-0">Industry Context</h2>
        <p>{study.sections.industryContext}</p>

        <h2>Part and Drawing Characteristics</h2>
        <p>{study.sections.partAndDrawing}</p>

        <h2>Manufacturing Decision</h2>
        <p>{study.sections.manufacturingDecision}</p>

        <h2>Inspection and Delivery</h2>
        <p>{study.sections.inspectionAndDelivery}</p>

        <h2>Repeat Order Scenario</h2>
        <p>{study.sections.repeatOrder}</p>
      </div>
    </div>
  </section>

  <!-- Other examples -->
  <section class="container-page py-14">
    <h2 class="text-2xl">Other Examples</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        others.map((item) => (
          <a href={`/case-studies/${item.slug}/`} class="card p-4 transition-colors hover:border-ti-400">
            <span class="inline-block rounded bg-ti-50 px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-ti-700">
              {item.industry}
            </span>
            <h3 class="mt-3 text-base text-ink-950">{getPartFamilyName(item.partFamily)}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-600">{item.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-ink-200 bg-ink-950">
    <div class="container-page py-14">
      <h2 class="text-2xl text-white">Upload a Similar Drawing</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-ink-300">
        Send the drawing and we will confirm the features that drive tolerance, the batch size that fits your schedule,
        and the inspection documents you receive.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/rfq/"
          class="rounded-md bg-white px-5 py-2.5 text-sm font-semibold text-ink-950 transition-colors hover:bg-ink-100"
        >
          Upload Drawing
        </a>
        <a
          href="/case-studies/"
          class="rounded-md border border-ink-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-ink-800"
        >
          View All Case Studies
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
