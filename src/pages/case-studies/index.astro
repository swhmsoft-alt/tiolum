---
/**
 * /case-studies/ — 匿名案例索引页。
 *
 * 规则：
 * - 案例全部标记 "Illustrative example"，不出现客户名、工厂名、价格。
 * - 卡片显示：industry badge + part family + tolerance + inspection。
 * - 公差数字从 CAPABILITIES 引用，不在本页写死。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CAPABILITIES } from '../../lib/capabilities';
import { CASE_STUDIES, getPartFamilyName } from '../../lib/caseStudies';
import { breadcrumbSchema } from '../../lib/schema';

const title = 'Illustrative Case Examples';
const description = `Anonymized examples of titanium parts, tolerances and inspection documents we coordinate across ${CASE_STUDIES.length} part families. Client and supplier identities are never disclosed.`;

const path = '/case-studies/';

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Case Studies', path },
  ]),
];
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <!-- Header -->
  <section class="border-b border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <nav aria-label="Breadcrumb" class="text-sm text-ink-500">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-ti-700">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink-700" aria-current="page">Case Studies</li>
        </ol>
      </nav>
      <p class="eyebrow mt-5">Case Studies</p>
      <h1 class="mt-3 max-w-3xl text-3xl md:text-4xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-600">
        Anonymized examples of the parts, tolerances and inspection documents we coordinate. Client and supplier
        identities are never disclosed.
      </p>
      <p class="mt-4 max-w-2xl rounded-md border border-warn-100 bg-warn-50 px-4 py-3 text-sm leading-relaxed text-warn-600">
        Until a real transaction is completed, examples are marked "Illustrative example" and describe typical
        scenarios, not confirmed client work.
      </p>
    </div>
  </section>

  <!-- Case cards -->
  <section class="container-page py-14">
    <h2 class="text-2xl">Examples by Part Family</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
      One example per part family we machine. Each case shows the industry situation, the drawing characteristics, the
      manufacturing decision and the inspection documents that ship with the order.
    </p>

    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {
        CASE_STUDIES.map((study) => (
          <article class="card flex flex-col p-6">
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-block rounded bg-ti-50 px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-ti-700">
                {study.industry}
              </span>
              <span class="inline-block rounded bg-warn-100 px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-warn-600">
                Illustrative example
              </span>
            </div>
            <h3 class="mt-4 text-lg">
              <a href={`/case-studies/${study.slug}/`} class="text-ink-950 hover:text-ti-700">
                {study.title}
              </a>
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{study.summary}</p>
            <dl class="mt-4 flex flex-col gap-2 text-sm">
              <div class="flex gap-3">
                <dt class="w-28 shrink-0 font-semibold text-ink-500">Part family</dt>
                <dd class="text-ink-700">
                  <a href={`/parts/${study.partFamily}/`} class="text-ti-700 underline underline-offset-2">
                    {getPartFamilyName(study.partFamily)}
                  </a>
                </dd>
              </div>
              <div class="flex gap-3">
                <dt class="w-28 shrink-0 font-semibold text-ink-500">Tolerance</dt>
                <dd class="text-ink-700">{CAPABILITIES.tolerance}</dd>
              </div>
              <div class="flex gap-3">
                <dt class="w-28 shrink-0 font-semibold text-ink-500">Inspection</dt>
                <dd class="text-ink-700">{study.inspection}</dd>
              </div>
            </dl>
            <a
              href={`/case-studies/${study.slug}/`}
              class="mt-5 inline-block text-sm font-semibold text-ti-700 underline underline-offset-4"
            >
              Read the example →
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- How to read these examples -->
  <section class="border-t border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <h2 class="text-2xl">How to Read These Examples</h2>
      <ul class="mt-6 flex flex-col gap-3 text-sm leading-relaxed text-ink-700">
        <li class="flex items-start gap-3">
          <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-ti-50 text-[11px] font-bold text-ti-700">✓</span>
          No client names, no factory names, no prices — the anonymised part is the point, not the reference list.
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-ti-50 text-[11px] font-bold text-ti-700">✓</span>
          Every example describes a typical scenario, not a confirmed client transaction.
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-ti-50 text-[11px] font-bold text-ti-700">✓</span>
          Tolerance, batch range and inspection documents follow the published capability table, not a special promise.
        </li>
      </ul>
      <a href="/capabilities/" class="mt-6 inline-block text-sm font-semibold text-ti-700 underline underline-offset-4">
        Full capabilities and scope boundaries →
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-ink-200 bg-ink-950">
    <div class="container-page py-14">
      <h2 class="text-2xl text-white">Send Us a Similar Drawing</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-ink-300">
        Upload the drawing and we will confirm the family it belongs to, the features that drive tolerance, and the
        inspection documents you receive.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/rfq/"
          class="rounded-md bg-white px-5 py-2.5 text-sm font-semibold text-ink-950 transition-colors hover:bg-ink-100"
        >
          Upload Drawing
        </a>
        <a
          href="/parts/"
          class="rounded-md border border-ink-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-ink-800"
        >
          All Part Families
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
