---
/**
 * /industries/[industry]/ — 行业应用页（B3 集群叶子页）。
 *
 * 由 src/lib/industries.ts 生成 3 条：
 *   /industries/chemical-processing/
 *   /industries/electroplating/
 *   /industries/industrial-automation/
 *
 * 规则：
 * - 能力数字（公差/批量/检验/后处理）从 CAPABILITIES 引用。
 * - 不出现价格、库存、SKU、现货交期、客户名称。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CAPABILITIES } from '../../lib/capabilities';
import { PART_FAMILIES } from '../../lib/parts';
import { TITANIUM_GRADES } from '../../lib/materials';
import { INDUSTRY_PROFILES, type IndustryProfile } from '../../lib/industries';
import { CASE_STUDIES } from '../../lib/caseStudies';
import { getProductUrl, getSeoCandidates, isProductPage } from '../../lib/part-products';
import { breadcrumbSchema, collectionPageSchema, serviceSchema } from '../../lib/schema';

export function getStaticPaths() {
  return INDUSTRY_PROFILES.map((industry) => ({
    params: { industry: industry.slug },
    props: { industry },
  }));
}

const { industry } = Astro.props as { industry: IndustryProfile };

const path = `/industries/${industry.slug}/`;
const title = industry.title;
const description = industry.shortDescription;

/** 该行业适配的零件族。 */
const families = industry.relatedFamilySlugs
  .map((slug) => PART_FAMILIES.find((family) => family.slug === slug))
  .filter((family) => family !== undefined);

/** 该行业优先牌号。 */
const grades = industry.priorityGradeSlugs
  .map((slug) => TITANIUM_GRADES.find((grade) => grade.slug === slug))
  .filter((grade) => grade !== undefined);

/** 该行业适配的已建页产品。 */
const relatedProducts = getSeoCandidates()
  .filter(isProductPage)
  .filter((product) => industry.relatedProductSlugs.includes(product.slug))
  .map((product) => ({ name: product.nameEn, href: getProductUrl(product) }));

/** 关联的匿名案例。 */
const cases = CASE_STUDIES.filter((study) => industry.caseStudySlugs.includes(study.slug));

const jsonLd = [
  collectionPageSchema({
    name: industry.name,
    description: industry.shortDescription,
    path,
  }),
  serviceSchema({
    name: `Titanium CNC machining for ${industry.name.toLowerCase()}`,
    serviceType: `Titanium CNC machining — ${industry.name}`,
    description: `${industry.shortDescription} Machined within ${CAPABILITIES.processes.join(' / ')} scope at ${CAPABILITIES.tolerance}.`,
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Industries', path: '/industries/' },
    { name: industry.name, path },
  ]),
];
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <!-- Header -->
  <section class="border-b border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <nav aria-label="Breadcrumb" class="text-sm text-ink-500">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-ti-700">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/industries/" class="hover:text-ti-700">Industries</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink-700" aria-current="page">{industry.name}</li>
        </ol>
      </nav>
      <p class="eyebrow mt-5">Industry Application</p>
      <h1 class="mt-3 max-w-3xl text-3xl md:text-4xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-600">{industry.shortDescription}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href="/rfq/"
          class="rounded-md bg-ti-700 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-ti-600"
        >
          Upload Drawing
        </a>
        <a
          href="/parts/"
          class="rounded-md border border-ink-300 px-5 py-2.5 text-sm font-semibold text-ink-800 transition-colors hover:bg-ink-50"
        >
          All Part Families
        </a>
      </div>
    </div>
  </section>

  <!-- Service context -->
  <section class="container-page py-14">
    <h2 class="text-2xl">What This Environment Does to a Part</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">{industry.serviceContext}</p>

    <p class="mt-4 max-w-3xl leading-relaxed text-ink-600">
      Parts in this environment run through the same route as every other order: {CAPABILITIES.processes.join(' and ')} at{' '}
      {CAPABILITIES.tolerance}, batch sizes {CAPABILITIES.batchRange}, and a material certificate 3.1 (EN 10204) for the
      delivered batch together with the first article inspection report and the dimensional inspection report.
      Manufacturing time at the supplier depends on the batch size and is confirmed per order after drawing review.
      Parts outside our scope are declined at review stage, before any quotation.
    </p>

    <div class="mt-8 grid gap-5 md:grid-cols-2">
      <div class="card p-6">
        <h3 class="text-lg text-ink-950">Failure modes to design against</h3>
        <ul class="mt-4 flex flex-col gap-2.5 text-sm leading-relaxed text-ink-700">
          {
            industry.failureModes.map((mode) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-ti-50 text-[11px] font-bold text-ti-700">
                  ✓
                </span>
                {mode}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card p-6">
        <h3 class="text-lg text-ink-950">What we inspect for</h3>
        <ul class="mt-4 flex flex-col gap-2.5 text-sm leading-relaxed text-ink-700">
          {
            industry.inspectionFocus.map((focus) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-ti-50 text-[11px] font-bold text-ti-700">
                  ✓
                </span>
                {focus}
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm leading-relaxed text-ink-600">
          Inspection plan is agreed before quotation, so the document set is known before you order.
        </p>
      </div>
    </div>
  </section>

  <!-- Grades -->
  <section class="border-t border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <h2 class="text-2xl">Grades Usually Specified Here</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
        Ordered by how often they are the right first answer in this environment. The final grade is confirmed
        against your drawing and your stated medium at engineering review.
      </p>

      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {
          grades.map((grade) => (
            <a href={`/materials/${grade.slug}/`} class="card group p-6 transition-colors hover:border-ti-400">
              <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">{grade.designation}</p>
              <h3 class="mt-2 text-lg text-ink-950 transition-colors group-hover:text-ti-700">{grade.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{grade.shortDescription}</p>
              <span class="mt-4 inline-block text-sm font-semibold text-ti-700">Grade details →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Part families -->
  <section class="container-page py-14">
    <h2 class="text-2xl">Part Families in This Environment</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
      The families whose geometry and tolerance drivers match this environment. Open a family for the full
      construction and inspection detail.
    </p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {
        families.map((family) => (
          <a href={`/parts/${family.slug}/`} class="card group p-6 transition-colors hover:border-ti-400">
            <h3 class="text-lg text-ink-950 transition-colors group-hover:text-ti-700">{family.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{family.shortDescription}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-ti-700">View part family →</span>
          </a>
        ))
      }
    </div>

    {
      relatedProducts.length > 0 && (
        <div class="mt-10">
          <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">Parts in this environment</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {relatedProducts.map((product) => (
              <a
                href={product.href}
                class="rounded border border-ink-200 px-3 py-1.5 text-sm text-ink-700 transition-colors hover:border-ti-400 hover:text-ti-700"
              >
                {product.name} →
              </a>
            ))}
          </div>
        </div>
      )
    }
  </section>

  <!-- Finishing notes -->
  <section class="border-t border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <h2 class="text-2xl">Surface Treatment Notes</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
        Finishing is quoted as a separate step: {CAPABILITIES.finishing.join(', ')}. A finishing record is issued
        wherever the surface treatment is part of the drawing specification.
      </p>
      <ul class="mt-6 flex flex-col gap-3">
        {
          industry.finishingNotes.map((note) => (
            <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-700">
              <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-ti-50 text-[11px] font-bold text-ti-700">
                ✓
              </span>
              {note}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Worked examples -->
  {
    cases.length > 0 && (
      <section class="border-t border-ink-200 bg-ink-50">
        <div class="container-page py-14">
          <h2 class="text-2xl">Worked Examples</h2>
          <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
            Illustrative examples of how a part in this environment was specified and inspected. They show the
            decision process, not a customer reference.
          </p>
          <div class="mt-8 flex flex-col gap-5">
            {cases.map((study) => (
              <a
                href={`/case-studies/${study.slug}/`}
                class="card group p-6 transition-colors hover:border-ti-400"
              >
                <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">{study.industry}</p>
                <h3 class="mt-2 text-lg text-ink-950 transition-colors group-hover:text-ti-700">{study.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-600">{study.summary}</p>
                <span class="mt-4 inline-block text-sm font-semibold text-ti-700">Read the example →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Cross links -->
  <section class="container-page py-14">
    <h2 class="text-2xl">Continue the Selection</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
      The environment points to the grade; the grade points to the part family; the part family points to the
      machining service. All four run through the same engineering review and the same inspection plan.
    </p>

    <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm">
      <a href="/industries/" class="font-semibold text-ti-700 underline underline-offset-4">
        Compare industries →
      </a>
      <a href="/materials/" class="font-semibold text-ti-700 underline underline-offset-4">
        Compare grades →
      </a>
      <a href="/parts/" class="font-semibold text-ti-700 underline underline-offset-4">
        All part families →
      </a>
      <a href="/titanium-cnc-machining-services/" class="font-semibold text-ti-700 underline underline-offset-4">
        Machining services →
      </a>
      <a href="/quality/" class="font-semibold text-ti-700 underline underline-offset-4">
        Quality and inspection →
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-ink-200 bg-ink-950">
    <div class="container-page py-14">
      <h2 class="text-2xl text-white">Send the Drawing for This Environment</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-ink-300">
        Include the medium, the temperature and the failure you need to prevent. We will confirm whether the part
        fits our process scope and which grade and geometry belong in it.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/rfq/"
          class="rounded-md bg-white px-5 py-2.5 text-sm font-semibold text-ink-950 transition-colors hover:bg-ink-100"
        >
          Upload Drawing
        </a>
        <a
          href="/contact/"
          class="rounded-md border border-ink-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-ink-800"
        >
          Talk to an Engineer
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
