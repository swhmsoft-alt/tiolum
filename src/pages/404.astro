---
/**
 * /404 — not-found page.
 *
 * Required by the Workers static asset config (not_found_handling: "404-page"),
 * which serves dist/404.html for unmatched routes.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page Not Found';
const description =
  'The page you are looking for does not exist. Upload your drawing for a quotation, or browse our capabilities and parts catalogue.';
---

<BaseLayout title={title} description={description} path="/404/" noindex>
  <section class="container-page py-20">
    <div class="mx-auto max-w-2xl">
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-3 text-3xl md:text-4xl">{title}</h1>
      <p class="mt-4 text-base leading-relaxed text-ink-600">
        The page you requested could not be found. It may have been moved or the link may be incorrect.
      </p>

      <h2 class="mt-10 text-xl">Still need a part machined to drawing?</h2>
      <p class="mt-3 leading-relaxed text-ink-600">
        Send the drawing instead of the link. We review manufacturability, confirm whether the part fits our
        machining scope, and reply with a quotation or an honest explanation.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/rfq/"
          class="rounded-md bg-ti-700 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-ti-600"
        >
          Upload Drawing / Request Quote
        </a>
        <a
          href="/contact/"
          class="rounded-md border border-ink-300 px-5 py-2.5 text-sm font-semibold text-ink-800 transition-colors hover:bg-ink-50"
        >
          Contact Us
        </a>
      </div>

      <h2 class="mt-12 text-xl">Where to go next</h2>
      <ul class="mt-4 flex flex-col gap-2 text-sm">
        <li>
          <a href="/capabilities/" class="text-ti-700 underline underline-offset-2 hover:text-ti-600">
            Machining capabilities and scope boundaries →
          </a>
        </li>
        <li>
          <a href="/parts/" class="text-ti-700 underline underline-offset-2 hover:text-ti-600">
            Parts catalogue: families and reference structures →
          </a>
        </li>
        <li>
          <a href="/quality/" class="text-ti-700 underline underline-offset-2 hover:text-ti-600">
            Quality and inspection documents →
          </a>
        </li>
        <li>
          <a href="/how-it-works/" class="text-ti-700 underline underline-offset-2 hover:text-ti-600">
            How a drawing becomes a delivered part →
          </a>
        </li>
        <li>
          <a href="/case-studies/" class="text-ti-700 underline underline-offset-2 hover:text-ti-600">
            Case studies →
          </a>
        </li>
        <li>
          <a href="/" class="text-ti-700 underline underline-offset-2 hover:text-ti-600">
            Back to home →
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
