---
/**
 * / — the homepage.
 *
 * Nine modules in the order fixed by the content document:
 * 1 Hero · 2 Trust bar · 3 Capability snapshot · 4 Part families ·
 * 5 Process flow · 6 Documents you receive · 7 Illustrative examples ·
 * 8 RFQ banner · 9 FAQ.
 *
 * All capability numbers are imported from src/lib/capabilities.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { CAPABILITIES } from '../lib/capabilities';
import { CASE_STUDIES, getPartFamilyName } from '../lib/caseStudies';
import { PART_FAMILIES } from '../lib/parts';
import { TITANIUM_GRADES } from '../lib/materials';
import { INDUSTRY_PROFILES } from '../lib/industries';
import {
  breadcrumbSchema,
  faqSchema,
  organizationSchema,
  serviceSchema,
  webSiteSchema,
} from '../lib/schema';

const title = 'Titanium CNC Machining and Custom Parts';
const description =
  'Titanium CNC machining from Baoji: 3-axis / 4-axis services, ±0.05 mm tolerance, small to medium batches, plus custom machined parts in five families.';

// 首页无多级面包屑层级，但补单层级 Home 的 BreadcrumbList：
// 满足结构化数据检查口径，且对搜索引擎而言是合法的面包屑声明。
// 注意：jsonLd 必须定义在 faqs 之后（TDZ），故放在文件末尾的 faqs 段落之后。

/**
 * 双驱动枢纽 —— 首页并列两条主线：
 * A 驱动轴 = 加工服务（工艺与供应链），B 驱动轴 = 加工零部件（选型与行业）。
 */
const dualPillars = [
  {
    key: 'services',
    eyebrow: 'Pillar A — Machining Services',
    heading: 'Titanium CNC Machining Services',
    lead: `Everything that has to happen around the cut, run as one coordinated service.`,
    points: [
      `${CAPABILITIES.processes.join(' and ')}, confirmed against your geometry`,
      `Tolerance ${CAPABILITIES.tolerance}, evaluated per feature with a DFM review`,
      `Batch range ${CAPABILITIES.batchRange}`,
      `Dual-source quotation, FAI and material certificate 3.1 (EN 10204)`,
      'Mutual NDA before any supplier sees your drawing',
    ],
    links: [
      { label: 'Service details', href: '/titanium-cnc-machining-services/' },
      { label: 'Capabilities and scope', href: '/capabilities/' },
      { label: 'Quality and inspection', href: '/quality/' },
      { label: 'How the order runs', href: '/how-it-works/' },
    ],
  },
  {
    key: 'parts',
    eyebrow: 'Pillar B — Machined Parts',
    heading: 'Custom Titanium CNC Machined Parts',
    lead: `Five part families, four titanium grades, three industries — all produced to your drawing.`,
    points: [
      'Mounting and structural components',
      'Blocks, housings and manifolds',
      'Flanges, plates and interfaces',
      'Tooling, fixtures and end effectors',
      'Custom and OEM mechanical components',
    ],
    links: [
      { label: 'All part families', href: '/parts/' },
      { label: 'Choose a titanium grade', href: '/materials/' },
      { label: 'Parts by industry', href: '/industries/' },
      { label: 'Worked examples', href: '/case-studies/' },
    ],
  },
] as const;


const processSteps = [
  {
    step: 'Upload drawing',
    detail: '2D PDF or 3D STEP, with material, quantity, tolerance and finishing.',
  },
  {
    step: 'Engineering review',
    detail: 'We check manufacturability within 3/4-axis scope and confirm or decline.',
  },
  {
    step: 'Dual-source quotation',
    detail: 'Two qualified suppliers quoted independently; you receive one consolidated offer.',
  },
  {
    step: 'Production & inspection',
    detail: 'FAI, dimensional report, material certificate before shipment.',
  },
  {
    step: 'Export delivery',
    detail: 'Export documents, packing photos, and archived drawing record for repeat orders.',
  },
] as const;

const documents = [
  'First article inspection (FAI) report',
  'Dimensional inspection report',
  'Material certificate 3.1',
  'Finishing record (where applicable)',
  'Packing photos before shipment',
  'Archived drawing and order record for repeat orders',
] as const;

const faqs = [
  {
    q: 'Do you own a factory?',
    a: 'No. We coordinate a qualified network of titanium CNC machining suppliers in Baoji, China, and manage engineering review, dual-source quotation, inspection coordination and export delivery.',
  },
  {
    q: 'What tolerance can you hold?',
    a: `Typically ${CAPABILITIES.tolerance}. Tolerance is confirmed per feature against your drawing before quoting.`,
  },
  {
    q: 'Will my drawing be shared with suppliers?',
    a: 'Not before a mutual NDA is in place. Drawings are reviewed internally first; supplier contact happens only after scope is confirmed.',
  },
  {
    q: 'Do you accept small batches?',
    a: `Yes. ${CAPABILITIES.batchRange}. Small batches are quoted with the same inspection process as larger orders.`,
  },
  {
    q: 'What if my part is outside your scope?',
    a: 'We will decline honestly and, where possible, point you to the right process category.',
  },
  {
    q: 'Do you offer machining services without parts?',
    a: 'Yes. The machining service — 3-axis and 4-axis milling, DFM review, dual-source quotation, inspection coordination and export delivery — is available on its own for buyers who already have their own supply chain. Send the drawing and state that you need the process quoted separately.',
  },
  {
    q: 'Which titanium grade should I use?',
    a: 'That depends on the service environment rather than on the part. Grade 2 for general corrosion resistance, Grade 5 for structural strength, Grade 7 where reducing acids are involved, Grade 9 for pressure and cold-formed applications. The grade is settled during the engineering review against your drawing and your medium.',
  },
] as const;

/**
 * 结构化数据 —— 定义在 faqs 之后，避免 const 暂时性死区。
 * 首页承担双驱动总枢纽角色：Service 的 offerCatalog 同时声明
 * 「加工服务」与「加工零部件」两条主线。
 */
const jsonLd = [
  organizationSchema(),
  webSiteSchema(),
  breadcrumbSchema([{ name: 'Home', path: '/' }]),
  serviceSchema({
    name: 'Titanium CNC machining services and custom titanium machined parts',
    serviceType: 'Titanium CNC machining services',
    description: `${CAPABILITIES.processes.join(' / ')} titanium machining coordinated from Baoji, China, with drawing-based custom titanium parts across five part families.`,
    offerCatalog: {
      name: 'Titanium CNC machining catalogue',
      description:
        'Machining services and part families available from one coordinated titanium supply chain.',
      items: [
        {
          name: 'Titanium CNC machining services',
          description: `3-axis and 4-axis titanium milling within ${CAPABILITIES.tolerance}, batch sizes ${CAPABILITIES.batchRange}, with DFM review, dual-source quotation and documented inspection.`,
        },
        {
          name: 'Custom titanium machined parts',
          description:
            'Drawing-based titanium parts in five families: mounting and structural components, blocks, housings and manifolds, flanges, plates and interfaces, tooling and end effectors, and custom OEM mechanical components.',
        },
      ],
    },
  }),
  faqSchema(faqs.map((item) => ({ q: item.q, a: item.a }))),
];
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <!-- 1. Hero -->
  <section class="border-b border-ink-200 bg-white">
    <div class="container-page py-20 md:py-28">
      <p class="eyebrow">Titanium CNC Machining</p>
      <h1 class="mt-4 max-w-4xl text-4xl md:text-5xl">{title}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-ink-600">
        Two ways to work with us: buy the machining service, or buy the part the service produces. Both run through
        the same Baoji supplier network, the same dual-source quotation and the same inspection plan.
      </p>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-600">
        {CAPABILITIES.processes.join(' / ')} · {CAPABILITIES.tolerance} · {CAPABILITIES.batchRange} ·
        {CAPABILITIES.materials.join(', ')}.
      </p>
      <p class="mt-4 max-w-2xl leading-relaxed text-ink-600">
        Upload your drawing for a manufacturability review and quotation. We will tell you honestly if it is
        outside our scope.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/rfq/"
          class="rounded-md bg-ti-700 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-ti-600"
        >
          Upload Drawing / Request Quote
        </a>
        <a
          href="/titanium-cnc-machining-services/"
          class="rounded-md border border-ink-300 px-6 py-3 text-sm font-semibold text-ink-800 transition-colors hover:bg-ink-50"
        >
          Machining Services
        </a>
        <a
          href="/parts/"
          class="rounded-md border border-ink-300 px-6 py-3 text-sm font-semibold text-ink-800 transition-colors hover:bg-ink-50"
        >
          Machined Parts
        </a>
      </div>
    </div>
  </section>

  <!-- 2. Trust bar -->
  <section class="border-b border-ink-200 bg-ink-50">
    <div class="container-page py-6">
      <ul class="flex flex-wrap items-center gap-x-8 gap-y-3 text-sm font-medium text-ink-600">
        {CAPABILITIES.trustBar.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <!-- 3. Dual-drive hub -->
  <section class="container-page py-14">
    <h2 class="text-2xl">Two Ways In</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
      Most buyers arrive with one of two questions: can you machine this, and can you make this part. Both answers
      are below, and both lead to the same drawing upload.
    </p>

    <div class="mt-8 grid gap-5 lg:grid-cols-2">
      {
        dualPillars.map((pillar) => (
          <div class="card flex flex-col p-6">
            <p class="eyebrow">{pillar.eyebrow}</p>
            <h3 class="mt-3 text-xl text-ink-950">{pillar.heading}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-600">{pillar.lead}</p>
            <ul class="mt-4 flex flex-col gap-2 text-sm leading-relaxed text-ink-700">
              {pillar.points.map((point) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-ti-50 text-[11px] font-bold text-ti-700">
                    ✓
                  </span>
                  {point}
                </li>
              ))}
            </ul>
            <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 border-t border-ink-200 pt-4 text-sm">
              {pillar.links.map((link) => (
                <a href={link.href} class="font-semibold text-ti-700 underline underline-offset-4">
                  {link.label} →
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 3. Capability snapshot -->
  <section class="container-page py-14">
    <h2 class="text-2xl">What We Machine</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
      A focused scope — not every titanium part. If your drawing fits the table below, we can review it.
    </p>

    <div class="mt-8 overflow-x-auto">
      <table class="data-table">
        <caption class="sr-only">Machining capability snapshot</caption>
        <thead>
          <tr>
            <th scope="col">Item</th>
            <th scope="col">Specification</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Process</th>
            <td>{CAPABILITIES.processes.join(', ')}</td>
          </tr>
          <tr>
            <th scope="row">Tolerance</th>
            <td>{CAPABILITIES.tolerance}</td>
          </tr>
          <tr>
            <th scope="row">Materials</th>
            <td>{CAPABILITIES.materials.join(', ')}</td>
          </tr>
          <tr>
            <th scope="row">Batch range</th>
            <td>{CAPABILITIES.batchRange}</td>
          </tr>
          <tr>
            <th scope="row">Finishing</th>
            <td>{CAPABILITIES.finishing.join(', ')}</td>
          </tr>
          <tr>
            <th scope="row">Inspection</th>
            <td>{CAPABILITIES.inspection.join(', ')}</td>
          </tr>
          <tr>
            <th scope="row">Lead time</th>
            <td>
              Confirmed per order after drawing review. Manufacturing time at the supplier depends on the batch
              size.
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <a
      href="/capabilities/"
      class="mt-6 inline-block text-sm font-semibold text-ti-700 underline underline-offset-4"
    >
      Full capabilities and scope boundaries →
    </a>
  </section>

  <!-- 4. Part families -->
  <section class="border-t border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <h2 class="text-2xl">Part Families We Focus On</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          PART_FAMILIES.map((family) => (
            <a href={`/parts/${family.slug}/`} class="card group p-5 transition-colors hover:border-ti-400">
              <h3 class="text-lg text-ink-950">{family.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{family.description}</p>
              <span class="mt-4 inline-block text-sm font-semibold text-ti-700">View part family →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4b. Materials axis -->
  <section class="container-page py-14">
    <h2 class="text-2xl">Choose the Titanium Grade</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
      {CAPABILITIES.materials.join(', ')} are all available, and the grade changes how the part is machined and
      finished. Compare the options, or send the drawing and let the engineering review settle it.
    </p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        TITANIUM_GRADES.map((grade) => (
          <a
            href={`/materials/${grade.slug}/`}
            class="card group flex flex-col p-5 transition-colors hover:border-ti-400"
          >
            <h3 class="text-lg text-ink-950 transition-colors group-hover:text-ti-700">{grade.name}</h3>
            <p class="mt-1 text-xs text-ink-500">{grade.designation}</p>
            <p class="mt-3 text-sm leading-relaxed text-ink-600">{grade.shortDescription}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-ti-700">Grade details →</span>
          </a>
        ))
      }
    </div>

    <a
      href="/materials/"
      class="mt-6 inline-block text-sm font-semibold text-ti-700 underline underline-offset-4"
    >
      Full grade selection guide →
    </a>
  </section>

  <!-- 4c. Industries axis -->
  <section class="border-t border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <h2 class="text-2xl">Parts by Industry</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
        The same process scope, applied to three service environments. Each one has its own failure modes, and they
        decide which grade and which part family belong in the drawing.
      </p>

      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {
          INDUSTRY_PROFILES.map((industry) => (
            <a
              href={`/industries/${industry.slug}/`}
              class="card group flex flex-col p-5 transition-colors hover:border-ti-400"
            >
              <h3 class="text-lg text-ink-950 transition-colors group-hover:text-ti-700">{industry.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{industry.shortDescription}</p>
              <span class="mt-4 inline-block text-sm font-semibold text-ti-700">Industry details →</span>
            </a>
          ))
        }
      </div>

      <a
        href="/industries/"
        class="mt-6 inline-block text-sm font-semibold text-ti-700 underline underline-offset-4"
      >
        All industry applications →
      </a>
    </div>
  </section>

  <!-- 5. Process flow -->
  <section class="container-page py-14">
    <h2 class="text-2xl">How a Drawing Becomes a Delivered Part</h2>
    <ol class="mt-8 grid gap-5 md:grid-cols-5">
      {
        processSteps.map((item, index) => (
          <li class="card p-5">
            <span class="grid h-7 w-7 place-items-center rounded-full bg-ti-50 text-xs font-bold text-ti-700">
              {index + 1}
            </span>
            <h3 class="mt-3 text-base">{item.step}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{item.detail}</p>
          </li>
        ))
      }
    </ol>
    <a
      href="/how-it-works/"
      class="mt-6 inline-block text-sm font-semibold text-ti-700 underline underline-offset-4"
    >
      Full process →
    </a>
  </section>

  <!-- 6. Documents you receive -->
  <section class="border-t border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <h2 class="text-2xl">What You Receive With Every Order</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          documents.map((doc) => (
            <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-700">
              <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-ti-50 text-[11px] font-bold text-ti-700">
                ✓
              </span>
              {doc}
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm leading-relaxed text-ink-600">
        Document availability depends on part and supplier capability; we confirm the inspection plan before
        quoting.
      </p>
    </div>
  </section>

  <!-- 7. Illustrative examples -->
  <section class="container-page py-14">
    <h2 class="text-2xl">Illustrative Examples</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
      Anonymized examples of the parts, tolerances and inspection documents we coordinate. Client and supplier
      identities are never disclosed.
    </p>

    <div class="mt-6 grid gap-5 md:grid-cols-2">
      {
        CASE_STUDIES.slice(0, 2).map((study) => (
          <article class="card flex flex-col p-6">
            <span class="inline-block rounded bg-warn-100 px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-warn-600">
              Illustrative example
            </span>
            <h3 class="mt-4 text-lg">
              <a href={`/case-studies/${study.slug}/`} class="text-ink-950 transition-colors hover:text-ti-700">
                {study.title}
              </a>
            </h3>
            <dl class="mt-4 flex flex-col gap-2 text-sm">
              <div class="flex gap-3">
                <dt class="w-28 shrink-0 font-semibold text-ink-500">Part family</dt>
                <dd class="text-ink-700">{getPartFamilyName(study.partFamily)}</dd>
              </div>
              <div class="flex gap-3">
                <dt class="w-28 shrink-0 font-semibold text-ink-500">Tolerance</dt>
                <dd class="text-ink-700">{CAPABILITIES.tolerance}</dd>
              </div>
              <div class="flex gap-3">
                <dt class="w-28 shrink-0 font-semibold text-ink-500">Inspection</dt>
                <dd class="text-ink-700">{study.inspection}</dd>
              </div>
            </dl>
            <a
              href={`/case-studies/${study.slug}/`}
              class="mt-5 inline-block text-sm font-semibold text-ti-700 underline underline-offset-4"
            >
              Read the example →
            </a>
          </article>
        ))
      }
    </div>

    <a
      href="/case-studies/"
      class="mt-6 inline-block text-sm font-semibold text-ti-700 underline underline-offset-4"
    >
      View all case studies →
    </a>
  </section>

  <!-- 8. RFQ banner -->
  <section class="border-t border-ink-200 bg-ink-950">
    <div class="container-page py-14">
      <h2 class="text-2xl text-white">Have a Drawing?</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-ink-300">
        Send it for a manufacturability review. We will confirm whether it fits 3-axis / 4-axis scope, then
        quote from two qualified suppliers.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/rfq/"
          class="rounded-md bg-white px-5 py-2.5 text-sm font-semibold text-ink-950 transition-colors hover:bg-ink-100"
        >
          Upload Drawing
        </a>
      </div>
    </div>
  </section>

  <!-- 9. FAQ -->
  <section class="container-page py-14">
    <h2 class="text-2xl">Frequently Asked Questions</h2>
    <div class="mt-6 flex flex-col divide-y divide-ink-200 border-y border-ink-200">
      {
        faqs.map((item) => (
          <details class="group py-5">
            <summary class="cursor-pointer list-none text-base font-semibold text-ink-950 marker:hidden">
              {item.q}
            </summary>
            <p class="mt-3 max-w-3xl text-sm leading-relaxed text-ink-600">{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>
