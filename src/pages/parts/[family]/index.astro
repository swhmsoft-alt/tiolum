---
/**
 * /parts/[family]/ — 零件族页（五个产品族共用一套结构）。
 *
 * 结构固定：示意图 → 典型特征 → 适用材料与公差 → 常见后处理 →
 * 批量与交期 → 质检文件 → 族内产品 → 重复采购场景 → CTA。
 *
 * 规则：
 * - 不出现价格、库存、SKU 编号、现货交期。
 * - 能力数字全部从 CAPABILITIES 引用，零件族文案从 src/lib/parts.ts 引用。
 * - 族页必须链接到本族已建页的产品（见「Products in This Family」），
 *   族页与产品页互为父子关系，权重垂直下沉。
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PartSchematic from '../../../components/PartSchematic.astro';
import { CAPABILITIES } from '../../../lib/capabilities';
import { PART_FAMILIES } from '../../../lib/parts';
import { TITANIUM_GRADES } from '../../../lib/materials';
import { INDUSTRY_PROFILES } from '../../../lib/industries';
import { getCaseStudyByFamily } from '../../../lib/caseStudies';
import {
  getProductsByFamily,
  getProductPagesByFamily,
  getProductUrl,
  isProductPage,
} from '../../../lib/part-products';
import { breadcrumbSchema, serviceSchema } from '../../../lib/schema';

export function getStaticPaths() {
  return PART_FAMILIES.map((family) => ({
    params: { family: family.slug },
    props: { family },
  }));
}

const { family } = Astro.props;

/**
 * meta title 控制在 60 字符内（含 " | Titolum" 后缀）。
 * family.title 本身以 "Titanium " 开头，后缀里再重复会挤掉关键短语 ——
 * 这里去掉前缀的 Titanium，并按长度选择后缀变体；H1 仍用完整的 family.title，
 * 可见文案不变。
 */
const familyLabel = family.title.replace(/^Titanium /, '');
const metaTitle =
  `${familyLabel} — Machined to Drawing`.length + 11 <= 60
    ? `${familyLabel} — Machined to Drawing`
    : `${familyLabel} — Machined`;
const description = `${family.title} machined to drawing in 3-axis / 4-axis scope. Materials, finishing, batch sizes and inspection documents.`;

const path = `/parts/${family.slug}/`;

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Parts', path: '/parts/' },
    { name: family.name, path },
  ]),
  serviceSchema({
    name: `${family.name} — Titanium CNC Machining`,
    description: `Custom ${family.name.toLowerCase()} machined from titanium within ${CAPABILITIES.processes.join(' / ')} scope at ${CAPABILITIES.tolerance}.`,
  }),
];

const others = PART_FAMILIES.filter((item) => item.slug !== family.slug);
const relatedCase = getCaseStudyByFamily(family.slug);

/** 本族已独立建页的产品 —— 族页链接到产品页，权重垂直下沉。 */
const familyProductPages = getProductPagesByFamily(family.slug);

/** 本族未独立建页的产品 —— 合并在本族页面内承接，不单独建页。 */
const familyOtherProducts = getProductsByFamily(family.slug).filter(
  (item) => !isProductPage(item) && item.reviewStatus !== 'excluded'
);

/** 与本族相关的牌号（材料簇 → 零件族垂直连接）。 */
const relatedGrades = TITANIUM_GRADES.filter((grade) =>
  grade.relatedFamilySlugs.includes(family.slug)
);

/** 与本族相关的行业（行业簇 → 零件族垂直连接）。 */
const relatedIndustries = INDUSTRY_PROFILES.filter((industry) =>
  industry.relatedFamilySlugs.includes(family.slug)
);
---

<BaseLayout title={metaTitle} description={description} path={path} jsonLd={jsonLd}>
  <!-- Header -->
  <section class="border-b border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <nav aria-label="Breadcrumb" class="text-sm text-ink-500">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-ti-700">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/parts/" class="hover:text-ti-700">Parts</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink-700" aria-current="page">{family.name}</li>
        </ol>
      </nav>
      <p class="eyebrow mt-5">Part Family</p>
      <h1 class="mt-3 max-w-3xl text-3xl md:text-4xl">{family.title}</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-600">
        Custom {family.name.toLowerCase()} machined from titanium within {CAPABILITIES.processes.join(' / ')} scope at {CAPABILITIES.tolerance}.
      </p>
    </div>
  </section>

  <!-- Schematic + typical features -->
  <section class="container-page py-14">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-start">
      <PartSchematic slug={family.slug} label={`Schematic of typical ${family.name.toLowerCase()} geometry`} />

      <div>
        <h2 class="text-2xl">Typical Features</h2>
        <p class="mt-3 leading-relaxed text-ink-600">{family.shortDescription}</p>
        <ul class="mt-5 flex flex-col gap-2.5 text-sm leading-relaxed text-ink-700">
          {family.typicalFeatures.map((feature) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-ti-50 text-[11px] font-bold text-ti-700">✓</span>
              {feature}
            </li>
          ))}
        </ul>

        <h3 class="mt-8 text-lg">Reference Structures</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-600">
          Typical geometry in this family. These describe the shape, not a stocked part — dimensions, tolerances and
          quantities follow your drawing.
        </p>
        <ul class="mt-4 flex flex-col gap-2 text-sm text-ink-700">
          {family.referenceStructure.map((item) => (
            <li class="border-l-2 border-ink-200 pl-3">{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>
  <!-- Material, tolerance & finishing -->
  <section class="border-t border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <h2 class="text-2xl">Material, Tolerance &amp; Finishing</h2>
      <div class="mt-8 overflow-x-auto">
        <table class="data-table">
          <caption class="sr-only">Materials, tolerance and finishing for {family.name}</caption>
          <thead>
            <tr>
              <th scope="col">Item</th>
              <th scope="col">Specification</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Materials</th>
              <td>
                {CAPABILITIES.materials.join(', ')}
                <span class="mt-1 block text-sm text-ink-500">Grade is quoted against the standard you specify on the drawing.</span>
              </td>
            </tr>
            <tr>
              <th scope="row">Tolerance</th>
              <td>
                {CAPABILITIES.tolerance}
                <span class="mt-1 block text-sm text-ink-500">{family.toleranceNote}</span>
              </td>
            </tr>
            <tr>
              <th scope="row">Finishing</th>
              <td>
                {CAPABILITIES.finishing.join(', ')}
                <span class="mt-1 block text-sm text-ink-500">{family.finishingNote}</span>
              </td>
            </tr>
            <tr>
              <th scope="row">Finishing lead time</th>
              <td class="text-ink-600">Adds {CAPABILITIES.finishingAddOn}.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-2">
        <div class="card p-6">
          <h3 class="text-lg text-ink-950">Grades used in this family</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-600">
            The grades normally specified for this geometry, with the selection logic behind each one.
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            {
              relatedGrades.map((grade) => (
                <a
                  href={`/materials/${grade.slug}/`}
                  class="rounded border border-ink-200 px-3 py-1.5 text-sm text-ink-700 transition-colors hover:border-ti-400 hover:text-ti-700"
                >
                  {grade.name} →
                </a>
              ))
            }
          </div>
          <a
            href="/materials/"
            class="mt-4 inline-block text-sm font-semibold text-ti-700 underline underline-offset-4"
          >
            Compare all grades →
          </a>
        </div>

        <div class="card p-6">
          <h3 class="text-lg text-ink-950">Industries using this family</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-600">
            The service environments this geometry usually comes from, and what each of them is defending against.
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            {
              relatedIndustries.map((industry) => (
                <a
                  href={`/industries/${industry.slug}/`}
                  class="rounded border border-ink-200 px-3 py-1.5 text-sm text-ink-700 transition-colors hover:border-ti-400 hover:text-ti-700"
                >
                  {industry.name} →
                </a>
              ))
            }
          </div>
          <a
            href="/industries/"
            class="mt-4 inline-block text-sm font-semibold text-ti-700 underline underline-offset-4"
          >
            All industry applications →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Batch & lead time -->
  <section class="container-page py-14">
    <h2 class="text-2xl">Batch &amp; Lead Time</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
      Batch range: {CAPABILITIES.batchRange}. Manufacturing time below is the time at the supplier once the order is
      confirmed; our own review and quotation time is quoted separately.
    </p>

    <div class="mt-8 overflow-x-auto">
      <table class="data-table">
        <caption class="sr-only">Lead time by batch size</caption>
        <thead>
          <tr>
            <th scope="col">Batch size</th>
            <th scope="col">Typical duration</th>
            <th scope="col">Driver</th>
          </tr>
        </thead>
        <tbody>
          {
            CAPABILITIES.leadTimes.map((row) => (
              <tr>
                <th scope="row">{row.batch}</th>
                <td>{row.days}</td>
                <td class="text-ink-600">{row.note}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-ink-500">
      Lead time is confirmed per order. Every quotation carries a committed date, and repeat orders are quoted from
      the archived drawing record.
    </p>

    <!-- 我方评审与报价时效（CAPABILITIES.responseTimes），与上方供应商制造工期严格区分 -->
    <h3 class="mt-10 text-lg">Review &amp; Quotation Response Times</h3>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-600">
      These are our own review and quotation times, separate from the manufacturing lead time above.
    </p>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
      {
        CAPABILITIES.responseTimes.map((row) => (
          <li class="border-l-2 border-ink-200 pl-3 text-sm leading-relaxed text-ink-700">
            <span class="font-semibold text-ink-950">{row.step}</span> — {row.time}
          </li>
        ))
      }
    </ul>
    <a href="/capabilities/" class="mt-6 inline-block text-sm font-semibold text-ti-700 underline underline-offset-4">
      Full response time table →
    </a>
  </section>
  <!-- Inspection documents -->
  <section class="border-t border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <h2 class="text-2xl">Quality Documents</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
        The documents below ship with the order. The inspection plan is agreed before quotation, not after
        production.
      </p>

      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          CAPABILITIES.inspection.map((doc) => (
            <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-700">
              <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-ti-50 text-[11px] font-bold text-ti-700">✓</span>
              {doc}
            </li>
          ))
        }
      </ul>

      <h3 class="mt-10 text-lg">What we report for this family</h3>
      <ul class="mt-4 flex flex-col gap-2 text-sm leading-relaxed text-ink-700">
        {family.inspectionFocus.map((item) => (
          <li class="border-l-2 border-ink-200 pl-3">{item}</li>
        ))}
      </ul>

      <a href="/quality/" class="mt-6 inline-block text-sm font-semibold text-ti-700 underline underline-offset-4">
        How inspection is carried out →
      </a>
    </div>
  </section>

  <!-- Products in this family -->
  <section class="container-page py-14">
    <h2 class="text-2xl">Products in This Family</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
      The parts below are the individual product types we machine inside this family. Each one has its own page
      describing the geometry, the buyer and the review points. Every part is still produced against your drawing.
    </p>

    {
      familyProductPages.length > 0 && (
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {familyProductPages.map((item) => (
            <a href={getProductUrl(item)} class="card flex flex-col p-5 transition-colors hover:border-ti-400">
              <h3 class="text-base text-ink-950">{item.nameEn}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{item.geometryFeatures[0]}</p>
              <span class="mt-4 inline-block text-sm font-semibold text-ti-700">View product →</span>
            </a>
          ))}
        </div>
      )
    }

    {
      familyOtherProducts.length > 0 && (
        <>
          <h3 class="mt-10 text-lg">Also Machined in This Family</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-600">
            These part types are machined in the same family and covered by this page rather than by a separate product
            page. Send the drawing and we will confirm the geometry against this family.
          </p>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            {familyOtherProducts.map((item) => (
              <li class="border-l-2 border-ink-200 pl-3 text-sm leading-relaxed text-ink-700">
                {item.nameEn}
                <span class="block text-xs text-ink-500">{item.geometryFeatures[0]}</span>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>

  <!-- Industry scenarios -->
  <section class="container-page py-14">
    <h2 class="text-2xl">Where These Parts Are Used</h2>
    <ul class="mt-6 flex flex-col gap-3">
      {family.industryScenarios.map((scenario) => (
        <li class="flex flex-col gap-1 border-l-2 border-ti-400 bg-ti-50 px-4 py-3">
          <span class="text-sm leading-relaxed text-ink-700">{scenario}</span>
        </li>
      ))}
    </ul>
    <p class="mt-5 text-sm text-ink-500">
      Application notes describe typical use. Suitability for your equipment is confirmed from the drawing and the
      service conditions.
    </p>
  </section>

  <!-- Repeat order scenarios -->
  <section class="border-t border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <h2 class="text-2xl">Repeat Purchase Scenarios</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
        Most orders in this family are not one-off. Once the drawing is approved and the inspection report is on
        file, re-ordering becomes a matter of referencing an archived record.
      </p>
      <ul class="mt-6 flex flex-col gap-3">
        {family.repeatScenarios.map((scenario) => (
          <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-700">
            <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-ti-50 text-[11px] font-bold text-ti-700">✓</span>
            {scenario}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Related example -->
  {
    relatedCase && (
      <section class="border-t border-ink-200 bg-ink-50">
        <div class="container-page py-14">
          <h2 class="text-2xl">Related Example</h2>
          <article class="card mt-6 p-6">
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-block rounded bg-ti-50 px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-ti-700">
                {relatedCase.industry}
              </span>
              <span class="inline-block rounded bg-warn-100 px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-warn-600">
                Illustrative example
              </span>
            </div>
            <h3 class="mt-4 text-lg">
              <a
                href={`/case-studies/${relatedCase.slug}/`}
                class="text-ink-950 transition-colors hover:text-ti-700"
              >
                {relatedCase.title}
              </a>
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{relatedCase.summary}</p>
            <a
              href={`/case-studies/${relatedCase.slug}/`}
              class="mt-4 inline-block text-sm font-semibold text-ti-700 underline underline-offset-4"
            >
              Read the example →
            </a>
          </article>
          <p class="mt-4 text-sm text-ink-500">
            Illustrative examples describe typical scenarios, not confirmed client work.
          </p>
        </div>
      </section>
    )
  }

  <!-- Other families -->
  <section class="container-page py-14">
    <h2 class="text-2xl">Other Part Families</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        others.map((item) => (
          <a href={`/parts/${item.slug}/`} class="card p-4 transition-colors hover:border-ti-400">
            <h3 class="text-base text-ink-950">{item.name}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-600">{item.shortDescription}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-ink-200 bg-ink-950">
    <div class="container-page py-14">
      <h2 class="text-2xl text-white">Upload Drawing for This Part Family</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-ink-300">
        Send the drawing and we will confirm the features that drive tolerance, the batch size that fits your
        schedule, and the inspection documents you receive.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/rfq/"
          class="rounded-md bg-white px-5 py-2.5 text-sm font-semibold text-ink-950 transition-colors hover:bg-ink-100"
        >
          Upload Drawing
        </a>
        <a
          href="/parts/"
          class="rounded-md border border-ink-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-ink-800"
        >
          All Part Families
        </a>
      </div>
      <p class="mt-6 text-sm leading-relaxed text-ink-400">
        This part family is not in your drawing? Send it anyway — we will confirm fit honestly.
      </p>
    </div>
  </section>
</BaseLayout>
