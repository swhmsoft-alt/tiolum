---
/**
 * /quality/ — the trust page the asset-light model depends on.
 *
 * All inspection documents and scope boundaries come from capabilities.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { CAPABILITIES } from '../lib/capabilities';
import { breadcrumbSchema, serviceSchema } from '../lib/schema';

const title = 'Quality and Inspection';
const description =
  'What we check, what documents you receive, and how dual sourcing protects quality — inspection plan agreed before quotation.';

const jsonLd = [
  serviceSchema(),
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Quality', path: '/quality/' }]),
];

const workflow = [
  {
    step: 'Drawing review',
    detail: 'Critical dimensions and tolerance features identified before production.',
  },
  {
    step: 'First article inspection (FAI)',
    detail: 'First part measured against the drawing before the batch continues.',
  },
  {
    step: 'Dimensional report',
    detail: 'Key features recorded and shared before shipment.',
  },
  {
    step: 'Finishing confirmation',
    detail: 'Surface treatment checked against the specification.',
  },
  {
    step: 'Pre-packing final check',
    detail: 'Visual and dimensional spot check; packing photos taken.',
  },
] as const;
---

<BaseLayout title={title} description={description} path="/quality/" jsonLd={jsonLd}>
  <!-- Page header -->
  <section class="border-b border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <p class="eyebrow">Quality</p>
      <h1 class="mt-3 max-w-3xl text-3xl md:text-4xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-600">
        What we check, what documents you receive, and how dual sourcing protects quality.
      </p>
    </div>
  </section>

  <!-- Inspection workflow -->
  <section class="container-page py-14">
    <h2 class="text-2xl">Inspection Workflow</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
      The inspection plan is agreed before quotation, so the documents you receive are known before you order.
    </p>
    <ol class="mt-8 flex flex-col gap-4">
      {
        workflow.map((item, index) => (
          <li class="flex gap-5">
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-ti-50 text-sm font-bold text-ti-700">
              {index + 1}
            </span>
            <div>
              <h3 class="text-lg">{item.step}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-600">{item.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Documents -->
  <section class="border-t border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <h2 class="text-2xl">Documents You Receive</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          CAPABILITIES.inspection.map((doc) => (
            <li class="card flex items-start gap-3 p-5">
              <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-ti-50 text-[11px] font-bold text-ti-700">
                ✓
              </span>
              <span class="text-sm leading-relaxed text-ink-800">{doc}</span>
            </li>
          ))
        }
        <li class="card flex items-start gap-3 p-5">
          <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-ti-50 text-[11px] font-bold text-ti-700">
            ✓
          </span>
          <span class="text-sm leading-relaxed text-ink-800">Finishing record (where applicable)</span>
        </li>
        <li class="card flex items-start gap-3 p-5">
          <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-ti-50 text-[11px] font-bold text-ti-700">
            ✓
          </span>
          <span class="text-sm leading-relaxed text-ink-800">Packing photos</span>
        </li>
      </ul>
      <p class="mt-6 text-sm leading-relaxed text-ink-600">
        Document set is confirmed before quotation. If a supplier cannot provide a required document, we say so
        before you order.
      </p>
    </div>
  </section>

  <!-- Dual-source quality logic -->
  <section class="container-page py-14">
    <h2 class="text-2xl">Why Dual-Source Quoting Protects You</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
      The same drawing is quoted by two qualified suppliers independently. We compare their process plan,
      inspection capability and lead time — not only commercial terms. If one supplier cannot meet the inspection
      requirement, we do not simply switch to the other one. This is a quality control mechanism, not a
      bargaining tactic.
    </p>
  </section>

  <!-- Scope boundary -->
  <section class="border-t border-ink-200 bg-ink-50">
    <div class="container-page py-14">
      <h2 class="text-2xl">Scope Boundary</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">
        We only quote parts within 3-axis / 4-axis scope at {CAPABILITIES.tolerance}. Parts outside this scope
        are declined at review stage — before any quotation, not after.
      </p>
      <ul class="mt-6 flex flex-col gap-3">
        {
          CAPABILITIES.notOffered.map((item) => (
            <li class="flex flex-col gap-1 border-l-2 border-warn-500 bg-warn-50 px-4 py-3">
              <span class="font-semibold text-ink-950">{item.item}</span>
              <span class="text-sm text-ink-600">— {item.reason}.</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="border-t border-ink-200 bg-ink-950">
    <div class="container-page py-14">
      <h2 class="text-2xl text-white">Review the Inspection Plan With Your Drawing</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-ink-300">
        Send the drawing and we will confirm which inspection documents apply to it before quotation.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/rfq/"
          class="rounded-md bg-white px-5 py-2.5 text-sm font-semibold text-ink-950 transition-colors hover:bg-ink-100"
        >
          Upload Drawing
        </a>
        <a
          href="/capabilities/"
          class="rounded-md border border-ink-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-ink-800"
        >
          Review Machining Capabilities
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
