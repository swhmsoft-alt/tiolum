---
/**
 * PartSchematic.astro — 产品族的示意几何图（内联 SVG 蓝图风格）。
 *
 * 规则：
 * - 这是"典型几何示意"，不是客户零件，也不是库存件。页面上必须标注。
 * - 图中不出现尺寸数字、公差数值、价格或型号，避免被当成可下单规格。
 * - 只表达形状关系：轮廓、孔位、台阶、腔体。
 * - slug 对应 src/lib/parts.ts 的五个产品族。
 */
interface Props {
  slug: string;
  /** 图形标题，供无障碍使用。 */
  label: string;
  class?: string;
}

const { slug, label, class: className } = Astro.props;

const stroke = '#2a3440';
const accent = '#1d4f6b';
const faint = '#8296a8';
---

<figure class={`schematic ${className ?? ''}`}>
  <svg
    viewBox="0 0 400 260"
    role="img"
    aria-label={label}
    class="schematic-canvas"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {slug === 'flanges-plates-interfaces' && (
      <g>
        <circle cx="130" cy="120" r="72" stroke={stroke} stroke-width="1.6" />
        <circle cx="130" cy="120" r="52" stroke={faint} stroke-width="1" />
        <circle cx="130" cy="120" r="34" stroke={stroke} stroke-width="1.6" />
        <circle cx="130" cy="120" r="26" stroke={faint} stroke-width="1" />
        <circle cx="130" cy="48" r="6" stroke={stroke} stroke-width="1.4" />
        <circle cx="192.2" cy="84" r="6" stroke={stroke} stroke-width="1.4" />
        <circle cx="192.2" cy="156" r="6" stroke={stroke} stroke-width="1.4" />
        <circle cx="130" cy="192" r="6" stroke={stroke} stroke-width="1.4" />
        <circle cx="67.8" cy="156" r="6" stroke={stroke} stroke-width="1.4" />
        <circle cx="67.8" cy="84" r="6" stroke={stroke} stroke-width="1.4" />
        <path d="M130 34v172M44 120h172" stroke={faint} stroke-width="0.8" stroke-dasharray="10 4 2 4" />
        <path d="M268 96h34v-14h60v14h14v48h-14v14h-60v-14h-34z" stroke={stroke} stroke-width="1.6" />
        <path d="M282 96v48M302 82v76M362 96v48" stroke={faint} stroke-width="1" />
        <path d="M250 120h24M250 112v16M274 112v16" stroke={accent} stroke-width="1" />
      </g>
    )}

    {slug === 'mounting-structural-components' && (
      <g>
        <path d="M96 200v-92h84v92" stroke={stroke} stroke-width="1.6" />
        <path d="M96 108l60-30 84 42-60 30z" stroke={faint} stroke-width="1.2" />
        <path d="M96 200l60-30 84 42-60 30z" stroke={faint} stroke-width="1.2" />
        <path d="M240 120v92" stroke={faint} stroke-width="1.2" />
        <circle cx="120" cy="140" r="8" stroke={accent} stroke-width="1.4" />
        <circle cx="120" cy="182" r="8" stroke={accent} stroke-width="1.4" />
        <circle cx="216" cy="150" r="8" stroke={accent} stroke-width="1.4" />
        <path d="M212 76v40" stroke={stroke} stroke-width="1.6" />
        <path d="M212 76l48 24v40l-48 24z" stroke={faint} stroke-width="1.2" />
        <circle cx="238" cy="106" r="6" stroke={accent} stroke-width="1.3" />
        <circle cx="238" cy="132" r="6" stroke={accent} stroke-width="1.3" />
      </g>
    )}


    {slug === 'blocks-housings-manifolds' && (
      <g>
        <path d="M80 190v-96h140v96z" stroke={stroke} stroke-width="1.6" />
        <path d="M80 190l40 26h140l-40-26" stroke={faint} stroke-width="1.2" />
        <path d="M220 190l40-26v-96l-40 26" stroke={faint} stroke-width="1.2" />
        <path d="M96 176v-68h108v68z" stroke={accent} stroke-width="1.2" stroke-dasharray="6 4" />
        <circle cx="108" cy="100" r="5" stroke={stroke} stroke-width="1.3" />
        <circle cx="192" cy="100" r="5" stroke={stroke} stroke-width="1.3" />
        <circle cx="108" cy="176" r="5" stroke={stroke} stroke-width="1.3" />
        <circle cx="192" cy="176" r="5" stroke={stroke} stroke-width="1.3" />
        <path d="M286 96h84v64h-84z" stroke={stroke} stroke-width="1.6" />
        <path d="M298 108h60v40h-60z" stroke={accent} stroke-width="1.1" stroke-dasharray="6 4" />
        <circle cx="294" cy="90" r="5" stroke={stroke} stroke-width="1.3" />
        <circle cx="362" cy="90" r="5" stroke={stroke} stroke-width="1.3" />
        <circle cx="294" cy="166" r="5" stroke={stroke} stroke-width="1.3" />
        <circle cx="362" cy="166" r="5" stroke={stroke} stroke-width="1.3" />
      </g>
    )}

    {slug === 'tooling-fixtures-end-effectors' && (
      <g>
        <path d="M60 96h180v28h24v36h-24v28H60z" stroke={stroke} stroke-width="1.6" />
        <path d="M60 124h180" stroke={faint} stroke-width="1" />
        <path d="M240 110h18v64h-18z" stroke={accent} stroke-width="1.3" />
        <circle cx="92" cy="110" r="6" stroke={accent} stroke-width="1.3" />
        <circle cx="132" cy="110" r="6" stroke={accent} stroke-width="1.3" />
        <circle cx="172" cy="110" r="6" stroke={accent} stroke-width="1.3" />
        <path d="M60 172h130v54H60z" stroke={stroke} stroke-width="1.6" />
        <path d="M78 188h64v24H78z" stroke={accent} stroke-width="1.1" stroke-dasharray="6 4" />
        <path d="M154 188h18v24h-18z" stroke={faint} stroke-width="1" />
        <path d="M30 138h300M40 199h180" stroke={faint} stroke-width="0.8" stroke-dasharray="10 4 2 4" />
      </g>
    )}

    {slug === 'custom-mechanical-components' && (
      <g>
        <path d="M40 76h100v44H40z" stroke={stroke} stroke-width="1.6" />
        <path d="M40 86h100M40 110h100" stroke={faint} stroke-width="1" />
        <path d="M140 84h80v28h-80z" stroke={stroke} stroke-width="1.6" />
        <path d="M220 92h52v12h-52z" stroke={stroke} stroke-width="1.6" />
        <path d="M272 94h88v8h-88z" stroke={accent} stroke-width="1.4" />
        <path d="M40 160h150v60H40z" stroke={stroke} stroke-width="1.6" />
        <path d="M54 174h122v32H54z" stroke={accent} stroke-width="1.1" stroke-dasharray="6 4" />
        <circle cx="66" cy="86" r="5" stroke={accent} stroke-width="1.3" />
        <circle cx="114" cy="86" r="5" stroke={accent} stroke-width="1.3" />
        <path d="M196 40v180" stroke={faint} stroke-width="0.8" stroke-dasharray="10 4 2 4" />
      </g>
    )}
  </svg>
  <figcaption class="schematic-caption">
    Typical geometry schematic — reference structure only, not a stock part.
  </figcaption>
</figure>

<style>
  .schematic {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border: 1px solid var(--color-ink-200);
    border-radius: 0.75rem;
    background-color: var(--color-ink-50);
    padding: 1rem;
  }

  .schematic-canvas {
    width: 100%;
    height: auto;
    display: block;
  }

  .schematic-caption {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-ink-500);
  }
</style>

      </g>
    )}
