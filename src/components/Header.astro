---
/**
 * Header.astro — primary navigation.
 *
 * Rules: no "Products", "Shop" or "Pricing" entries. The primary CTA always
 * points to /rfq/.
 */
import { BRAND } from '../lib/brand';

const path = Astro.url.pathname;

const links = [
  { label: 'Services', href: '/titanium-cnc-machining-services/' },
  { label: 'Parts', href: '/parts/' },
  { label: 'Materials', href: '/materials/' },
  { label: 'Industries', href: '/industries/' },
  { label: 'Quality', href: '/quality/' },
  { label: 'Case Studies', href: '/case-studies/' },
  { label: 'About', href: '/about/' },
];

const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-ink-200 bg-white/95 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label={`${BRAND.name} home`}>
      <span
        class="grid h-8 w-8 place-items-center rounded bg-ink-950 text-[13px] font-bold text-white"
        aria-hidden="true">Ti</span>
      <span class="text-[17px] font-bold tracking-tight text-ink-950">{BRAND.name}</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'rounded px-3 py-2 text-sm font-medium transition-colors',
              isActive(link.href)
                ? 'text-ti-700'
                : 'text-ink-600 hover:bg-ink-50 hover:text-ink-900',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/rfq/"
        class="hidden rounded-md bg-ti-700 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-ti-600 sm:inline-block"
      >
        Upload Drawing
      </a>
      <details class="relative lg:hidden">
        <summary
          class="grid h-9 w-9 cursor-pointer list-none place-items-center rounded border border-ink-200 text-ink-700"
          aria-label="Open navigation menu"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <div class="absolute right-0 mt-2 w-56 rounded-lg border border-ink-200 bg-white p-2 shadow-lg">
          {
            links.map((link) => (
              <a href={link.href} class="block rounded px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-50">
                {link.label}
              </a>
            ))
          }
          <a
            href="/rfq/"
            class="mt-1 block rounded bg-ti-700 px-3 py-2 text-center text-sm font-semibold text-white"
          >
            Upload Drawing
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
