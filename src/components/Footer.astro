---
/**
 * Footer.astro
 *
 * The bottom-bar disclaimer is a trust device, not filler: it prevents a
 * buyer from mistaking Titolum for a factory. Keep it verbatim.
 */
import { BRAND } from '../lib/brand';
import { CAPABILITIES } from '../lib/capabilities';

const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Capabilities',
    links: [
      { label: 'Machining Capabilities', href: '/capabilities/' },
      { label: 'Quality & Inspection', href: '/quality/' },
      { label: 'How It Works', href: '/how-it-works/' },
    ],
  },
  {
    heading: 'Parts',
    links: [
      { label: 'All Part Families', href: '/parts/' },
      { label: 'Flanges & Fittings', href: '/parts/titanium-flanges/' },
      { label: 'Brackets & Mounts', href: '/parts/titanium-brackets/' },
      { label: 'Housings & Covers', href: '/parts/titanium-housings/' },
      { label: 'Shafts & Bushings', href: '/parts/titanium-shafts-bushings/' },
      { label: 'Replacement Parts & Spares', href: '/parts/titanium-replacement-parts/' },
      { label: 'OEM Components', href: '/parts/titanium-oem-components/' },
    ],
  },
  {
    heading: 'Company',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Case Studies', href: '/case-studies/' },
      { label: 'Resources', href: '/blog/' },
      { label: 'Contact', href: '/contact/' },
    ],
  },
];
---

<footer class="mt-24 border-t border-ink-200 bg-ink-50">
  <div class="container-page py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="grid h-8 w-8 place-items-center rounded bg-ink-950 text-[13px] font-bold text-white" aria-hidden="true">Ti</span>
          <span class="text-[17px] font-bold tracking-tight text-ink-950">{BRAND.name}</span>
        </div>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-600">
          Drawing-based titanium CNC machining supply from {BRAND.location}.
        </p>
        <p class="mt-2 text-sm text-ink-600">
          3-axis / 4-axis · {CAPABILITIES.tolerance} · Small to medium batches.
        </p>
      </div>

      {
        columns.map((col) => (
          <div>
            <h2 class="text-[13px] font-bold uppercase tracking-wider text-ink-500">{col.heading}</h2>
            <ul class="mt-4 flex flex-col gap-2.5">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-ink-600 transition-colors hover:text-ti-700">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 border-t border-ink-200 pt-6">
      <p class="text-xs leading-relaxed text-ink-500">
        © {year} {BRAND.name}. All rights reserved.
      </p>
      <p class="mt-1 text-xs leading-relaxed text-ink-500">
        We coordinate qualified suppliers; we do not own machining equipment.
      </p>
    </div>
  </div>
</footer>
